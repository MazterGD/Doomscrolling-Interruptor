<?xml version="1.0" encoding="utf-8"?>
<!--
  Doomscrolling-Interruptor

  Note what is NOT declared here: android.permission.INTERNET.

  Without it the Linux kernel denies this UID network sockets outright, so no code in this
  app — nor in any library it links — can transmit anything off the device. The privacy
  guarantee is therefore enforced by the platform, not by a promise in a policy document.
  Adding this permission would defeat the project's central claim, so any pull request that
  introduces it should be rejected.

  Nor is SYSTEM_ALERT_WINDOW declared: the blocking overlay uses TYPE_ACCESSIBILITY_OVERLAY,
  which an accessibility service may use without the "draw over other apps" grant.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      No dependency in the current tree asks for INTERNET, so this element removes nothing
      today. It is here as a standing instruction to the manifest merger: should any future
      dependency declare the network permission, strip it rather than grant it.

      CI additionally inspects the built APK with aapt2 on every run, so the guarantee is
      verified against the shipped artifact rather than inferred from this file.
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Interruptor">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Interruptor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          exported="false" is correct here: the platform's accessibility manager is what binds
          this service, gated by BIND_ACCESSIBILITY_SERVICE, so no other app needs access.

          The AccessibilityPolicy lint check warns that the accessibility APIs are being used
          for something other than assistive technology. That is accurate, and it is the
          project's deliberate design — see README and docs/DETECTION.md for what the service
          reads and why. It is suppressed here rather than worked around.
        -->
        <service
            android:name=".service.DoomscrollAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            tools:ignore="AccessibilityPolicy">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
