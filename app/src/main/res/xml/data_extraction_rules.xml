<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup is already disabled outright via android:allowBackup="false". These rules state the
  same intent explicitly for the Android 12+ transfer paths, so that neither a cloud backup
  nor a device-to-device transfer can carry this app's data off the handset.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
